# ── Temple Backend Environment ──────────────────────────────────
# Copy this file to .env and fill in your values

# App
APP_NAME="Pavagarh Temple CMS"
APP_VERSION="1.0.0"
ENVIRONMENT=development
DEBUG=true

# Backend URL (adjust for production)
BACKEND_URL=http://localhost:8000
FRONTEND_URL=http://localhost:5173

# Database - PostgreSQL
DATABASE_URL=postgresql+asyncpg://temple_user:temple_pass@localhost:5432/temple_db
DATABASE_URL_SYNC=postgresql+psycopg2://temple_user:temple_pass@localhost:5432/temple_db

# JWT Security
SECRET_KEY=CHANGE_THIS_TO_A_SECURE_256BIT_RANDOM_KEY_IN_PRODUCTION
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7

# Cookie Security (set to true in production with HTTPS)
COOKIE_SECURE=false
COOKIE_SAMESITE=lax

# CORS - Allowed Origins
CORS_ORIGINS=["http://localhost:5173","http://localhost:3000","http://localhost:4173"]

# File Uploads
UPLOAD_DIR=uploads
MAX_FILE_SIZE_MB=10

# Rate Limiting
LOGIN_RATE_LIMIT=5/minute
API_RATE_LIMIT=100/minute

# Account Security
MAX_FAILED_ATTEMPTS=5
LOCKOUT_MINUTES=30

# First Super Admin (created on first startup)
SUPER_ADMIN_EMAIL=admin@temple.com
SUPER_ADMIN_PASSWORD=Admin@123!
SUPER_ADMIN_NAME=Temple Administrator
